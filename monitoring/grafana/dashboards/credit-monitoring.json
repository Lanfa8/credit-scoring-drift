    {
      "type": "table",
      "title": "Task status per batch",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "credit_pipeline_task_success",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "OK",
                  "color": "green"
                },
                "0": {
                  "text": "FAILED",
                  "color": "red"
                }
              }
            }
          ],
          "custom": {
            "cellOptions": {
              "type": "color-background"
            },
            "align": "center"
          },
          "noValue": "-"
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "groupingToMatrix",
          "options": {
            "rowField": "batch",
            "columnField": "task",
            "valueField": "Value"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "batch\\task"
              }
            ]
          }
        }
      ],
      "description": "1 = task finished, 0 = task failed. Blocked batches stop at ingest."
    },
    {
